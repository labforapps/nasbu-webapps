{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "lawyers-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/lawyers-app",
      "sourceRoot": "projects/lawyers-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "localize": true,
            "outputPath": "dist/lawyers-app",
            "index": "projects/lawyers-app/src/index.html",
            "main": "projects/lawyers-app/src/main.ts",
            "polyfills": "projects/lawyers-app/src/polyfills.ts",
            "tsConfig": "projects/lawyers-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/lawyers-app/src/favicon.ico",
              "projects/lawyers-app/src/assets"
            ],
            "styles": [
              "projects/lawyers-app/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/lawyers-app/src/environments/environment.ts",
                  "with": "projects/lawyers-app/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "lawyers-app:build:production"
            },
            "development": {
              "browserTarget": "lawyers-app:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "lawyers-app:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/lawyers-app/src/test.ts",
            "polyfills": "projects/lawyers-app/src/polyfills.ts",
            "tsConfig": "projects/lawyers-app/tsconfig.spec.json",
            "karmaConfig": "projects/lawyers-app/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/lawyers-app/src/favicon.ico",
              "projects/lawyers-app/src/assets"
            ],
            "styles": [
              "projects/lawyers-app/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "practice-app": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "projects/practice-app",
      "sourceRoot": "projects/practice-app/src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": "es-PR",
        "locales": {
          "en": {
            "translation": "src/locale/messages.en.json",
            "baseHref": ""
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:browser",
          "options": {
            "localize": true,
            "outputPath": "dist/practice-app",
            "index": "projects/practice-app/src/index.html",
            "main": "projects/practice-app/src/main.ts",
            "polyfills": "projects/practice-app/src/polyfills.ts",
            "tsConfig": "projects/practice-app/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/practice-app/src/favicon.ico",
              "projects/practice-app/src/assets"
            ],
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "projects/practice-app/src/styles.scss"
            ],
            "scripts": []
          },
          "configurations": {
            "en": {
              "localize": ["en"]
            },
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "2kb",
                  "maximumError": "4kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "projects/practice-app/src/environments/environment.ts",
                  "with": "projects/practice-app/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "localize": false,
              "buildOptimizer": false,
              "optimization": false,
              "vendorChunk": true,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "browserTarget": "practice-app:build:production"
            },
            "development": {
              "browserTarget": "practice-app:build:development"
            },
            "en": {
              "browserTarget": "practice-app:build:development,en"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n",
          "options": {
            "browserTarget": "practice-app:build"
          }
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/practice-app/src/test.ts",
            "polyfills": "projects/practice-app/src/polyfills.ts",
            "tsConfig": "projects/practice-app/tsconfig.spec.json",
            "karmaConfig": "projects/practice-app/karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "projects/practice-app/src/favicon.ico",
              "projects/practice-app/src/assets"
            ],
            "styles": [
              "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
              "projects/practice-app/src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    },
    "core-services": {
      "projectType": "library",
      "root": "projects/core-services",
      "sourceRoot": "projects/core-services/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/core-services/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/core-services/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/core-services/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/core-services/src/test.ts",
            "tsConfig": "projects/core-services/tsconfig.spec.json",
            "karmaConfig": "projects/core-services/karma.conf.js"
          }
        }
      }
    },
    "core-models": {
      "projectType": "library",
      "root": "projects/core-models",
      "sourceRoot": "projects/core-models/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/core-models/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/core-models/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/core-models/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "main": "projects/core-models/src/test.ts",
            "tsConfig": "projects/core-models/tsconfig.spec.json",
            "karmaConfig": "projects/core-models/karma.conf.js"
          }
        }
      }
    }
  },
  "defaultProject": "lawyers-app"
}
