# Copiar a .env (no se versiona) y completar. En CI van como secretos del repositorio.

# Ambiente bajo prueba. Nunca producción.
E2E_BASE_URL=https://dev.nasbulegal.com
E2E_API_URL=https://apidev.nasbulegal.com/api

# Cuentas de prueba (INVENTARIO.md, sección 2). Un rol sin credenciales deja sus pruebas omitidas.
E2E_OWNER_ULTIMATE_USER=
E2E_OWNER_ULTIMATE_PASSWORD=
E2E_OWNER_STARTER_USER=
E2E_OWNER_STARTER_PASSWORD=
E2E_OWNER_LIMITE_USER=
E2E_OWNER_LIMITE_PASSWORD=
E2E_COLAB_ESCRITURA_USER=
E2E_COLAB_ESCRITURA_PASSWORD=
E2E_COLAB_LECTURA_USER=
E2E_COLAB_LECTURA_PASSWORD=
E2E_COLAB_SIN_EXPEDIENTE_USER=
E2E_COLAB_SIN_EXPEDIENTE_PASSWORD=
E2E_SUSCRIPCION_IMPAGA_USER=
E2E_SUSCRIPCION_IMPAGA_PASSWORD=
E2E_SUSCRIPCION_SUSPENDIDA_USER=
E2E_SUSCRIPCION_SUSPENDIDA_PASSWORD=

# Opcionales
# E2E_COGNITO_CLIENT_ID=      # por defecto, el cliente público de QA
# E2E_API_TOKEN=              # salta Cognito al preparar datos (backend local o de mocks)
# E2E_MOCK=/ruta/mock.js      # módulo con install(context) para correr contra mocks locales
