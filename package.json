{
  "name": "nasbu-webapps",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng build --project=core-models && ng build --project=core-services && ng serve --project=practice-app",
    "build": "ng build",
    "build:models": "ng build --project=\"core-models\" --watch",
    "build:services": "ng build --project=\"core-services\" --watch",
    "start:all": "npm run start && npm run build:models && npm run build:services",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build-qa": "ng build --project=core-models && ng build --project=core-services && ng build --project=practice-app --configuration=qa",
    "build-prod": "ng build --project=core-models && ng build --project=core-services && ng build --project=practice-app --prod"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~13.3.0",
    "@angular/cdk": "^13.3.2",
    "@angular/common": "~13.3.0",
    "@angular/compiler": "~13.3.0",
    "@angular/core": "~13.3.0",
    "@angular/forms": "~13.3.0",
    "@angular/material": "^13.3.2",
    "@angular/platform-browser": "~13.3.0",
    "@angular/platform-browser-dynamic": "~13.3.0",
    "@angular/router": "~13.3.0",
    "@aws-amplify/ui-angular": "^2.4.18",
    "@hreimer/angular-image-viewer": "0.13.1",
    "@ngx-translate/core": "^13.0.0",
    "@ngx-translate/http-loader": "^6.0.0",
    "@sentry/angular-ivy": "^7.120.4",
    "angular2-text-mask": "^9.0.0",
    "aws-amplify": "^4.3.31",
    "bootstrap": "^5.1.3",
    "file-saver": "^2.0.5",
    "google-libphonenumber": "^3.2.3",
    "guid-typescript": "^1.0.9",
    "intl-tel-input": "^17.0.3",
    "moment": "^2.29.4",
    "ng2-tooltip-directive": "^2.10.3",
    "ngx-avatar": "^4.1.0",
    "ngx-awesome-uploader": "^13.0.1",
    "ngx-doc-viewer": "^2.1.2",
    "ngx-mask": "14.0",
    "ngx-mat-select-search": "^5.0.0",
    "ngx-mat-timepicker": "^14.0.2",
    "ngx-material-timepicker": "^5.5.3",
    "ngx-permissions": "^13.0.1",
    "ngx-spinner": "^13.0.0",
    "ngx-timer": "^1.0.6",
    "ngx-toastr": "^14.3.0",
    "rimraf": "^3.0.2",
    "rxjs": "~7.5.0",
    "sweetalert2": "^11.4.17",
    "text-mask-addons": "^3.8.0",
